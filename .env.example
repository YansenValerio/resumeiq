# =============================================
# ResumeIQ - Environment Variables
# =============================================
# Copy file ini ke .env.local lalu isi nilai-nilainya
# JANGAN commit .env.local ke Git!

# ---------------------------------------------
# Google Gemini API
# ---------------------------------------------
# Dapat dari: https://aistudio.google.com/app/apikey
# Free tier: 15 req/menit, 1500 req/hari
GEMINI_API_KEY=your_gemini_api_key_here

# Model yang dipakai. CATATAN: gemini-2.0-flash-exp SUDAH dipensiun Google (404).
# Pakai gemini-2.5-flash (default produksi) atau gemini-2.0-flash (lebih cepat).
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------
# Supabase
# ---------------------------------------------
# Dapat dari: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key (HANYA untuk server-side, jangan expose ke client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------------------------
# App Configuration
# ---------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ResumeIQ

# ---------------------------------------------
# Rate Limiting
# ---------------------------------------------
# Maksimal analisis per hari untuk guest user
MAX_DAILY_ANALYSES_GUEST=3
# Maksimal analisis per hari untuk user login
MAX_DAILY_ANALYSES_USER=10

# ---------------------------------------------
# Optional: Analytics
# ---------------------------------------------
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---------------------------------------------
# Optional: Error Monitoring (Sentry)
# ---------------------------------------------
# Kalau DSN kosong, Sentry otomatis no-op (tidak kirim event apa pun).
# Dapat dari: https://sentry.io -> Project Settings -> Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN dipakai client & server; aman di-expose ke browser.
NEXT_PUBLIC_SENTRY_DSN=
# Label environment di dashboard Sentry (production / preview / development).
NEXT_PUBLIC_SENTRY_ENV=development
# Hanya untuk build CI/Vercel — upload source map biar stack trace ter-unminify.
# Dapat dari: https://sentry.io -> Settings -> Auth Tokens (scope: project:releases)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------------------------------------------
# Development Only
# ---------------------------------------------
# Set ke 'true' untuk mock Gemini API saat development (hemat quota)
USE_MOCK_GEMINI=false
